# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# On Windows, scripts\new-env.ps1 creates the whole file for you instead.

# Database password. Stick to letters and digits (it goes into a URL).
POSTGRES_PASSWORD=

# Signs login tokens. Generate one with:  openssl rand -hex 32
SECRET_KEY=

# The first admin account, created on first start when there are no users.
# You can remove the password from this file after your first sign-in.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator

# Optional
# HYDRO_PORT=8000
# HYDRO_BIND=127.0.0.1   # 0.0.0.0 also exposes it on your home network
# DB_PORT=5432
