# Copy to backend/.env for local development (uvicorn --reload).
# Use the POSTGRES_PASSWORD from the top-level .env (docker compose up -d db).
DATABASE_URL=postgresql+psycopg://hydro:<POSTGRES_PASSWORD>@localhost:5432/hydro
SECRET_KEY=dev-secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-please
